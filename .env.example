# Public-safe template — no secrets and no real Production values are stored here.
# See docs/environment-config-contract.md for the full contract this file follows.
#
# Your actual .env is gitignored and never committed. Copy this file to .env and fill in real
# values for whichever environment you're building against.

# Which environment this build targets. Must be exactly one of: development, staging, production
# — no other value is accepted, and there is no default/fallback if this is missing or misspelled.
#   development -> points at the deployed Development AWS resources (IntervalDevelopmentStack —
#                  see docs/cdk-infrastructure.md). Get real values from that stack's outputs,
#                  never from this file.
#   staging     -> points at Staging/Beta AWS resources (not provisioned yet — see
#                  docs/environment-separation-plan.md)
#   production  -> points at the existing, live Production AWS resources documented in
#                  CLAUDE.md's "AWS Resources" section
INTERVAL_ENV=development

# API Gateway base URL for the selected environment. Public build config, not a secret.
EXPO_PUBLIC_API_BASE_URL=https://example.invalid

# Cognito region, user pool ID, and app client ID for the selected environment. All three are
# public build config (the Cognito app client has no client secret) — safe to embed in a client
# build, never a reason to treat this file as sensitive.
EXPO_PUBLIC_COGNITO_REGION=us-east-2
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
EXPO_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
