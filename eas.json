{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "distribution": "store",
      "developmentClient": false,
      "environment": "preview",
      "env": {
        "INTERVAL_ENV": "staging"
      },
      "autoIncrement": true
    },
    "staging-internal": {
      "extends": "staging",
      "distribution": "internal"
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6809260111"
      }
    }
  }
}
